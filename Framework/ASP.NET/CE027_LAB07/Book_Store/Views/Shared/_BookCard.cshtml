@model Book_Store.Models.Book

<div class="card h-100 shadow-sm book-card">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text text-muted">
            <small>by @Model.Author</small>
        </p>

        <div class="mb-2">
            <span class="badge bg-primary">@Model.Category</span>
        </div>

        <p class="card-text">
            @if (Model.Description.Length > 80)
            {
                <text>@Model.Description.Substring(0, 80)...</text>
            }
            else
            {
                <text>@Model.Description</text>
            }
        </p>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div>
                <span class="h5 mb-0">$@Model.Price.ToString("F2")</span>
            </div>
            <div>
                <i class="bi bi-star-fill text-warning"></i>
                <span class="ms-1">@Model.Rating.ToString("F1")</span>
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-sm btn-primary w-100">View Details</button>
        </div>
    </div>
</div>

<style>
    .book-card {
        transition: transform 0.2s;
    }

    .book-card:hover {
        transform: translateY(-5px);
    }
</style>
