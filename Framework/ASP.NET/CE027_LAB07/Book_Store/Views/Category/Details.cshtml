@model List<Book_Store.Models.Book>

@{
    ViewData["Title"] = $"Books in {ViewBag.Category.Name}";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary mb-3">
                <i class="bi bi-arrow-left"></i> Back to Categories
            </a>
            <h1 class="fw-bold">@ViewBag.Category.Name</h1>
            <p class="text-muted lead">@ViewBag.Category.Description</p>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="row g-4">
            @foreach (var book in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm book-card">
                        <div class="card-body">
                            <h5 class="card-title">
                                <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id" class="text-decoration-none">
                                    @book.Name
                                </a>
                            </h5>
                            <p class="card-text text-muted">
                                <small>by @book.Author</small>
                            </p>

                            <p class="card-text">
                                @if (book.Description.Length > 80)
                                {
                                    <text>@book.Description.Substring(0, 80)...</text>
                                }
                                else
                                {
                                    <text>@book.Description</text>
                                }
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div>
                                    <span class="h5 mb-0 text-success">₹@book.Price.ToString("F2")</span>
                                </div>
                                <div>
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <span class="ms-1">@book.Rating.ToString("F1")</span>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-light border-0">
                            <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-primary w-100">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> No books found in this category yet.
        </div>
    }
</div>

<style>
    h1 {
        color: #2c3e50;
        font-size: 2.5rem;
    }

    .lead {
        font-size: 1.1rem;
        font-weight: 500;
    }

    .book-card {
        border: none;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

    .book-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15) !important;
    }

    .card-title a {
        color: #2c3e50;
        font-weight: 600;
        transition: color 0.2s;
    }

    .card-title a:hover {
        color: #0d6efd;
    }

    .card-footer {
        background-color: #f8f9fa !important;
        padding: 0.75rem;
    }

    .card-text {
        line-height: 1.6;
    }
</style>
