@model Book_Store.Models.Book

@{
    ViewData["Title"] = $"Delete Confirmation - {Model.Name}";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-circle"></i> Delete Book Confirmation</h4>
                </div>

                <div class="card-body text-center py-5">
                    <i class="bi bi-trash display-1 text-danger mb-3"></i>

                    <h5 class="mb-3 fw-bold">Are you sure you want to delete this book?</h5>

                    <div class="alert alert-warning" role="alert">
                        <strong>Book:</strong> @Model.Name<br>
                        <strong>Author:</strong> @Model.Author<br>
                        <strong>Category:</strong> @Model.Category
                    </div>

                    <p class="text-muted mb-4">
                        <i class="bi bi-info-circle"></i> This action cannot be undone. The book will be permanently removed from the store.
                    </p>

                    <form asp-action="Delete" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> No, Keep It
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="bi bi-check-circle"></i> Yes, Delete It
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Book Summary Card -->
            <div class="card mt-4 bg-light">
                <div class="card-body">
                    <h6 class="text-muted mb-3">Book Summary</h6>

                    <div class="row mb-2">
                        <div class="col-6">
                            <small class="text-muted">Price:</small>
                            <p class="mb-0 fw-bold text-success">₹@Model.Price.ToString("F2")</p>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Rating:</small>
                            <p class="mb-0">
                                <i class="bi bi-star-fill text-warning"></i> @Model.Rating / 5.0
                            </p>
                        </div>
                    </div>

                    <hr>

                    <small class="text-muted">Description:</small>
                    <p class="small text-justify">
                        @if (Model.Description.Length > 150)
                        {
                            <text>@Model.Description.Substring(0, 150)...</text>
                        }
                        else
                        {
                            <text>@Model.Description</text>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }

    .display-1 {
        opacity: 0.8;
    }

    .btn-lg {
        padding: 0.75rem 1.5rem;
        font-weight: 600;
    }

    .text-justify {
        text-align: justify;
    }
</style>
