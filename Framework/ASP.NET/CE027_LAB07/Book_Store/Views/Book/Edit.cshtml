@model Book_Store.Models.Book

@{
    ViewData["Title"] = $"Edit Book - {Model.Name}";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Edit Book Details</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate class="needs-validation">
                        @Html.AntiForgeryToken()

                        <input asp-for="Id" type="hidden" />

                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle"></i> Modify the book details below and click "Save Changes" to update.
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Enter book title">
                            <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Author" class="form-label fw-bold"></label>
                            <input asp-for="Author" class="form-control" placeholder="Enter author name">
                            <span asp-validation-for="Author" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label fw-bold"></label>
                            <select asp-for="Category" class="form-select">
                                <option value="">-- Select a Category --</option>
                                @foreach (var category in ViewBag.Categories ?? new List<string>())
                                {
                                    <option value="@category" selected="@(Model.Category == category)">@category</option>
                                }
                            </select>
                            <span asp-validation-for="Category" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Enter book description"></textarea>
                            <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                            <small class="text-muted">Minimum 10 characters required</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Price" class="form-label fw-bold">Price (₹)</label>
                                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00">
                                    <span asp-validation-for="Price" class="text-danger small d-block mt-1"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Rating" class="form-label fw-bold">Rating (0-5)</label>
                                    <input asp-for="Rating" type="number" step="0.1" min="0" max="5" class="form-control" placeholder="0.0">
                                    <span asp-validation-for="Rating" class="text-danger small d-block mt-1"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Publisher" class="form-label fw-bold"></label>
                                    <input asp-for="Publisher" class="form-control" placeholder="Enter publisher name (optional)">
                                    <span asp-validation-for="Publisher" class="text-danger small d-block mt-1"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="PublishedYear" class="form-label fw-bold"></label>
                                    <input asp-for="PublishedYear" type="number" min="1900" max="2100" class="form-control" placeholder="e.g., 2023">
                                    <span asp-validation-for="PublishedYear" class="text-danger small d-block mt-1"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .card {
        border: none;
        border-radius: 10px;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
        padding: 1.5rem;
    }

    .form-label {
        color: #2c3e50;
    }

    .form-control, .form-select {
        border: 1px solid #ddd;
        border-radius: 5px;
        transition: all 0.3s;
    }

    .form-control:focus, .form-select:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
    }

    button[type="submit"] {
        font-weight: 600;
    }
</style>
