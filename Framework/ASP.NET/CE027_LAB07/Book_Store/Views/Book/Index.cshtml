@model List<Book_Store.Models.Book>

@{
    ViewData["Title"] = "All Books";
}

<div class="mb-4">
    <h2 class="fw-bold text-dark">All Books</h2>
    <p class="text-muted">Browse our collection of books</p>
</div>

@if (Model != null && Model.Count > 0)
{
    <div class="mb-3">
        <p class="text-muted">
            Showing <strong>@Model.Count @(Model.Count == 1 ? "book" : "books")</strong>
        </p>
    </div>

    <div class="row g-4">
        @foreach (var book in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            <a asp-action="Details" asp-route-id="@book.Id" class="text-decoration-none text-dark">
                                @book.Name
                            </a>
                        </h5>
                        <p class="text-muted small">
                            by <strong>@book.Author</strong>
                        </p>

                        <p class="card-text small">
                            @if (book.Description.Length > 100)
                            {
                                <text>@book.Description.Substring(0, 100)...</text>
                            }
                            else
                            {
                                <text>@book.Description</text>
                            }
                        </p>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="badge bg-light text-dark">@book.Category</span>
                            <span class="text-warning">
                                <i class="bi bi-star-fill"></i> @book.Rating.ToString("F1")
                            </span>
                        </div>

                        <div class="mt-2 pt-2 border-top">
                            <p class="mb-0"><strong>₹@book.Price.ToString("F2")</strong></p>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-0">
                        <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-primary w-100">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info text-center py-5" role="alert">
        <i class="bi bi-info-circle display-4 mb-3"></i>
        <p class="lead">No books found</p>
    </div>
}

<style>
    .card {
        transition: all 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1) !important;
    }

    .card-title a:hover {
        color: #0d6efd !important;
    }
</style>
