@model Book_Management.Models.Book

@{
    ViewData["Title"] = "Book" + Model.BookId;
}

<h2>Book @Model.BookId</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Book Id</th>
            <th>Title</th>
            <th>Author</th>
            <th>Category</th>
            <th>Price</th>
            <th>PublishedYear</th>
        </tr>
    </thead>

    <tbody>
        <tr>
            <td>@Model.BookId</td>
           <td>@Model.Title</td>
           <td>@Model.Author</td>
           <td>@Model.Category</td>
           <td>@Model.Price</td>
           <td>@Model.PublishedYear</td>
            </tr>
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Back to List</a>