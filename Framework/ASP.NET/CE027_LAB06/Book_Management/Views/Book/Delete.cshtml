@model Book_Management.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<h2>Delete Book</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this book?
</div>

<div class="card">
    <div class="card-body">

        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.BookId</dd>

            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>
            
            <dt class="col-sm-3">Author</dt>
            <dd class="col-sm-9">@Model.Author</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">@Model.Price</dd>

            <dt class="col-sm-3">PublishedYear</dt>
            <dd class="col-sm-9">@Model.PublishedYear</dd>
        </dl>

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="BookId" />

            <button type="submit" class="btn btn-danger">
                Yes, Delete
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>